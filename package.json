{
	"name": "@agsci/leaflet-components",
	"version": "0.0.5",
	"license": "MIT",
	"author": "Soil Diagnostics, Inc. <developer@soildiagnostics.com>",
	"homepage": "https://github.com/kbhalerao/leaflet_components.git",
	"bugs": "https://github.com/kbhalerao/leaflet_components/issues",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.2.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-cloudflare": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"publint": "^0.1.9",
		"svelte": "^5.2.2",
		"svelte-check": "^3.4.3",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"vitest": "^1.0.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"@agsci/leaflet-components": "^0.0.8",
		"@geoman-io/leaflet-geoman-free": "^2.17.0",
		"@turf/turf": "^7.1.0",
		"just-flush": "^2.3.0",
		"leaflet": "^1.9.4",
		"leaflet-spin": "^1.1.2",
		"leaflet.fullscreen": "^3.0.2",
		"leaflet.gridlayer.googlemutant": "^0.14.1",
		"spin.js": "^4.1.1",
		"svelte-geolocation": "^0.3.0"
	}
}
